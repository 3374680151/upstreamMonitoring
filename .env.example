# Upstream 运行环境变量
#
# 复制为 .env 后填入真实值。.env 已被 .gitignore 排除，密钥不会进 git / 不会开源泄露。
# 业务配置（站点、推送、SMTP、Webhook）在 Web UI 中完成并写入 MySQL 数据库，不走 .env。
# 本地直接 `python3 app.py` 会自动读取 .env；Docker 见 docker-compose.yml。

# ── MySQL 数据库（必填）──
# 所有业务数据都存 MySQL。密码只放在本地 .env，切勿写进源码或提交仓库。
DB_HOST=127.0.0.1
DB_PORT=3306
# Docker 一键部署：请保持 root（compose 内置的 mysql 仅创建 root 账户）。
# 裸机 / 已有 MySQL：可填任意已建好、且对 DB_NAME 有权限的用户。
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=upstream

# ── 性能与超时（可选）──
# 每个 app 进程最多保留的 MySQL 连接数；默认 8，代码会限制在 1～32。
DB_POOL_SIZE=8

# 连接池繁忙时最多等待多少秒；超时后快速返回错误，避免请求无限排队。
DB_POOL_ACQUIRE_TIMEOUT=5

# MySQL 建连、读、写超时（秒）。用于限制数据库网络异常造成的长时间阻塞。
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=15
DB_WRITE_TIMEOUT=15

# 请求 NewAPI / sub2api 等外部上游的超时（秒）。
# 只限制单次网络等待，不改变主站 key 接口现有的 2 秒安全请求间隔。
UPSTREAM_HTTP_TIMEOUT=15

# API 请求达到该耗时后输出脱敏慢请求日志（毫秒）；设为 0 可关闭。
SLOW_REQUEST_THRESHOLD_MS=500

# ── 运行时（可选）──
# 监听地址：本地默认 127.0.0.1；容器内应设为 0.0.0.0
HOST=127.0.0.1

# 监听端口
PORT=8000

# FastAPI 进程级监控调度器。生产环境保持 1；仅在导入/接口调试时可关闭。
SCHEDULER_ENABLED=1

# 是否开放 FastAPI Swagger/OpenAPI 文档。默认关闭，避免对外暴露内部接口。
ENABLE_API_DOCS=0

# 展示时区（APP_TIMEZONE 优先，其次 TZ，默认 Asia/Shanghai）
APP_TIMEZONE=Asia/Shanghai

# 操作系统时区（容器内生效，docker-compose 也读取它）。一般与 APP_TIMEZONE 一致即可。
# TZ=Asia/Shanghai

# 是否播种示例站点（Demo NewAPI）。默认不播种；设为 1 可在空库首启时插入一个示例站点。
# SEED_DEMO=0

# 控制台登录密码。
# - 留空 = 不启用登录（仅建议本地 127.0.0.1 或可信内网直连时使用）。
# - 设置后，所有 /api/* 接口都需要先登录；Web 首屏会显示登录页。
# 对公网/外网暴露时务必设置本项（否则任何人都能读取上游密钥、增删渠道），
# 并配合 HTTPS 反向代理 / IP 白名单使用。
CONSOLE_PASSWORD=

# 登录会话有效期（秒，默认 604800 = 7 天，最小 300）
CONSOLE_SESSION_TTL=604800

# ── Apifox 接口同步（可选）──
# Apifox Open API 访问令牌（Apifox 头像 → 账号设置 → API 访问令牌）。
# 仅用于把接口设计推送到 Apifox 云端项目（见 AGENTS.md「接口设计与 Apifox 同步」），
# 只放本机 .env，不进 git；运行期后端不读取它。
APIFOX_ACCESS_TOKEN=
